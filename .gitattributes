# Normalize line endings — keep LF in the repo across Windows/macOS/Linux.
* text=auto eol=lf

# Godot / GDScript and project text files
*.gd    text eol=lf
*.godot text eol=lf
*.cfg   text eol=lf
*.tres  text eol=lf
*.tscn  text eol=lf
*.md    text eol=lf
*.json  text eol=lf

# Binary assets (never normalized)
*.png binary
*.jpg binary
*.webp binary
*.mp4 binary
*.ttf binary
*.otf binary
